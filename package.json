{
  "name": "pinejs-core",
  "version": "1.3.0",
  "versionName": "Cedar",
  "description": "Next-generation fine-grained reactive declarative micro-framework for the modern web with CDN support, signals, and ultra-fast DOM updates.",
  "main": "dist/pine.js",
  "module": "dist/pine.esm.js",
  "types": "dist/pine.d.ts",
  "unpkg": "dist/pine.min.js",
  "jsdelivr": "dist/pine.min.js",
  "keywords": [
    "declarative",
    "signals",
    "reactivity",
    "fine-grained",
    "micro-framework",
    "alpinejs",
    "cdn",
    "lightweight"
  ],
  "scripts": {
    "build": "node build.js",
    "build:esbuild": "node build.js --esbuild",
    "build:terser": "node build.js --terser",
    "test": "echo \"Open tests/test-suite.html in your browser\""
  },
  "author": "PineJS Core Team",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "terser": "^5.51.2"
  }
}
