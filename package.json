{
  "name": "pinejs-core",
  "version": "1.5.0",
  "versionName": "Larch",
  "description": "Next-generation fine-grained reactive declarative micro-framework for the modern web with CDN support, signals, and ultra-fast DOM updates.",
  "main": "dist/pine.js",
  "module": "dist/pine.esm.js",
  "types": "dist/pine.d.ts",
  "unpkg": "dist/pine.min.js",
  "jsdelivr": "dist/pine.min.js",
  "keywords": [
    "declarative",
    "signals",
    "reactivity",
    "fine-grained",
    "micro-framework",
    "alpinejs",
    "cdn",
    "lightweight"
  ],
  "files": [
    "dist",
    "docs/logo.svg",
    "docs/favicon.svg",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/pine.d.ts",
      "import": "./dist/pine.esm.js",
      "require": "./dist/pine.js",
      "default": "./dist/pine.js"
    },
    "./esm": "./dist/pine.esm.js",
    "./min": "./dist/pine.min.js"
  },
  "scripts": {
    "build": "node build.js",
    "build:esbuild": "node build.js --esbuild",
    "build:terser": "node build.js --terser",
    "prepublishOnly": "node build.js",
    "test": "echo \"Open tests/test-suite.html in your browser\""
  },
  "author": "PineJS Core Team",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "terser": "^5.51.2"
  }
}
